record(stringin, "$(P)$(R=)Name") {
    field(DESC, "Native SNMPv3 identity read")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.2.1.1.5.0 STRING: 128")
    field(FLNK, "$(P)$(R=)AuditName")
}
record(sub, "$(P)$(R=)AuditName") {
    field(DESC, "Value and alarm at read completion")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)$(R=)Name.UDF NPP")
    field(INPB, "$(P)$(R=)Name.PACT NPP")
    field(INPC, "$(P)$(R=)Name.SEVR NPP")
    field(INPD, "$(P)$(R=)Name.STAT NPP")
    field(INPE, "$(P)$(R=)Name.UDF NPP")
}
