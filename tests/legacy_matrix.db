record(ai, "$(P)Analog") {
    field(DESC, "Legacy raw integer conversion")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.4.0 INTEGER: 128 sR")
    field(LINR, "SLOPE")
    field(ESLO, "0.1")
    field(PREC, "1")
    field(SCAN, ".1 second")
}
record(longin, "$(P)Integer") {
    field(DESC, "Legacy integer input")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.2.0 INTEGER: 128")
    field(SCAN, ".1 second")
}
record(stringin, "$(P)Text") {
    field(DESC, "Legacy string input")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 STRING: 128")
    field(SCAN, ".1 second")
}
record(waveform, "$(P)Wave") {
    field(DESC, "Legacy character waveform input")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 STRING: 128")
    field(FTVL, "CHAR")
    field(NELM, "128")
    field(SCAN, ".1 second")
}
record(ao, "$(P)AnalogSet") {
    field(DESC, "Legacy converted integer SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.5.0 INTEGER: 128 iR")
    field(LINR, "SLOPE")
    field(ESLO, "0.1")
    field(PREC, "1")
}
record(longout, "$(P)IntegerSet") {
    field(DESC, "Legacy integer SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.6.0 INTEGER: 128 i")
}
record(stringout, "$(P)TextSet") {
    field(DESC, "Legacy string SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.7.0 STRING: 128 s")
}
