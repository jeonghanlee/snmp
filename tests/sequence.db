record(ai, "$(P)A") {
    field(DESC, "SNMP request sequencing fixture")
    field(DTYP, "$(DTYP=SnmpRequest)")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128")
    field(FLNK, "$(P)AuditA")
}
record(sub, "$(P)AuditA") {
    field(DESC, "SNMP request sequencing fixture")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)A NPP")
    field(INPB, "$(P)A.PACT NPP")
    field(INPC, "$(P)A.SEVR NPP")
}
record(longin, "$(P)B") {
    field(DESC, "SNMP request sequencing fixture")
    field(DTYP, "$(DTYP=SnmpRequest)")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.2.0 INTEGER: 128")
    field(FLNK, "$(P)AuditB")
}
record(sub, "$(P)AuditB") {
    field(DESC, "SNMP request sequencing fixture")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)B NPP")
    field(INPB, "$(P)B.PACT NPP")
    field(INPC, "$(P)B.SEVR NPP")
}
record(ai, "$(P)Shared") {
    field(DESC, "SNMP request sequencing fixture")
    field(DTYP, "$(DTYP=SnmpRequest)")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128")
    field(FLNK, "$(P)AuditShared")
}
record(sub, "$(P)AuditShared") {
    field(DESC, "SNMP request sequencing fixture")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Shared NPP")
    field(INPB, "$(P)Shared.PACT NPP")
    field(INPC, "$(P)Shared.SEVR NPP")
}
record(ai, "$(P)Raw") {
    field(DESC, "SNMP request sequencing fixture")
    field(DTYP, "$(DTYP=SnmpRequest)")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.4.0 INTEGER: 128 sR")
    field(LINR, "SLOPE")
    field(ESLO, "0.1")
    field(PREC, "1")
    field(FLNK, "$(P)AuditRaw")
}
record(sub, "$(P)AuditRaw") {
    field(DESC, "Converted value at forward link")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Raw NPP")
    field(INPB, "$(P)Raw.PACT NPP")
    field(INPC, "$(P)Raw.SEVR NPP")
}
record(stringin, "$(P)Text") {
    field(DESC, "SNMP request sequencing fixture")
    field(DTYP, "$(DTYP=SnmpRequest)")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 STRING: 128")
    field(FLNK, "$(P)TextSink")
}
record(stringin, "$(P)TextSink") {
    field(DESC, "String read by the forward link")
    field(INP, "$(P)Text NPP")
    field(FLNK, "$(P)AuditText")
}
record(sub, "$(P)AuditText") {
    field(DESC, "String completion at forward link")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Text.UDF NPP")
    field(INPB, "$(P)Text.PACT NPP")
    field(INPC, "$(P)Text.SEVR NPP")
}
record(fanout, "$(P)All") {
    field(DESC, "SNMP request sequencing fixture")
    field(LNK1, "$(P)A")
    field(LNK2, "$(P)B")
    field(LNK3, "$(P)Shared")
    field(LNK4, "$(P)Raw")
    field(LNK5, "$(P)Text")
}
