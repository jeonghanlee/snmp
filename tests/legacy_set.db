record(ao, "$(P)AnalogSet") {
    field(DESC, "Native converted integer SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.5.0 INTEGER: 128 iR")
    field(LINR, "SLOPE")
    field(ESLO, "0.1")
    field(PREC, "1")
}
record(longout, "$(P)IntegerSet") {
    field(DESC, "Native integer SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.6.0 INTEGER: 128 i")
}
record(stringout, "$(P)TextSet") {
    field(DESC, "Native string SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.7.0 STRING: 128 s")
}
record(ai, "$(P)AnalogRead") {
    field(DESC, "Shared OID analog readback")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.5.0 INTEGER: 128 sR")
    field(LINR, "SLOPE")
    field(ESLO, "0.1")
    field(PREC, "1")
    field(SCAN, ".1 second")
}
record(longin, "$(P)IntegerRead") {
    field(DESC, "Shared OID integer readback")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.6.0 INTEGER: 128")
    field(SCAN, ".1 second")
}
record(stringin, "$(P)TextRead") {
    field(DESC, "Shared OID string readback")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.7.0 STRING: 128")
    field(SCAN, ".1 second")
}
