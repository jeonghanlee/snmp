record(ai, "$(P)A") {
    field(DESC, "Lifecycle analog request")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128")
    field(PINI, "NO")
    field(SCAN, "Passive")
    field(DISS, "INVALID")
    field(FLNK, "$(P)AuditA")
}
record(sub, "$(P)AuditA") {
    field(DESC, "Analog value and state at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)A NPP")
    field(INPB, "$(P)A.PACT NPP")
    field(INPC, "$(P)A.SEVR NPP")
    field(INPD, "$(P)A.STAT NPP")
    field(INPE, "$(P)A.UDF NPP")
    field(INPF, "$(P)A.RVAL NPP")
}
record(longin, "$(P)B") {
    field(DESC, "Lifecycle integer request")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST_B=$(HOST)) public .1.3.6.1.4.1.55555.2.0 INTEGER: 128")
    field(FLNK, "$(P)AuditB")
}
record(sub, "$(P)AuditB") {
    field(DESC, "Integer value and state at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)B NPP")
    field(INPB, "$(P)B.PACT NPP")
    field(INPC, "$(P)B.SEVR NPP")
    field(INPD, "$(P)B.STAT NPP")
    field(INPE, "$(P)B.UDF NPP")
}
record(longin, "$(P)C") {
    field(DESC, "Third serial request")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 INTEGER: 128")
    field(FLNK, "$(P)AuditC")
}
record(sub, "$(P)AuditC") {
    field(DESC, "Third result at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)C NPP")
    field(INPB, "$(P)C.PACT NPP")
    field(INPC, "$(P)C.SEVR NPP")
    field(INPD, "$(P)C.STAT NPP")
    field(INPE, "$(P)C.UDF NPP")
}
record(ai, "$(P)Shared") {
    field(DESC, "Independent waiter for A OID")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128")
    field(FLNK, "$(P)AuditShared")
}
record(sub, "$(P)AuditShared") {
    field(DESC, "Shared OID result at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Shared NPP")
    field(INPB, "$(P)Shared.PACT NPP")
    field(INPC, "$(P)Shared.SEVR NPP")
    field(INPD, "$(P)Shared.STAT NPP")
    field(INPE, "$(P)Shared.UDF NPP")
}
record(fanout, "$(P)Both") {
    field(DESC, "Submit two independent inputs")
    field(PINI, "$(START=NO)")
    field(LNK0, "$(P)A")
    field(LNK1, "$(P)B")
}
record(fanout, "$(P)Invalid") {
    field(DESC, "Continue after unresolved link")
    field(LNK0, "$(P)A")
    field(LNK1, "$(P)Missing.PROC")
    field(LNK2, "$(P)B")
}
