record(longout, "$(P)LegacySet") {
    field(DESC, "Legacy integer SET on the shared OID")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.11.0 INTEGER: 128 i")
}
record(longout, "$(P)SharedSet") {
    field(DESC, "Request integer SET on the shared OID")
    field(DTYP, "SnmpRequest")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.11.0 INTEGER: 128 i")
    field(FLNK, "$(P)AuditSharedSet")
}
record(sub, "$(P)AuditSharedSet") {
    field(DESC, "Shared SET value and state at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)SharedSet NPP")
    field(INPB, "$(P)SharedSet.PACT NPP")
    field(INPC, "$(P)SharedSet.SEVR NPP")
    field(INPD, "$(P)SharedSet.STAT NPP")
    field(INPE, "$(P)SharedSet.UDF NPP")
}
record(longin, "$(P)SharedRead") {
    field(DESC, "Legacy readback of the shared OID")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.11.0 INTEGER: 128")
    field(SCAN, ".1 second")
}
