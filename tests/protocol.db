record(stringin, "$(P)Name") {
    field(DESC, "Native agent identity read")
    field(DTYP, "$(DTYP)")
    field(INP, "@$(HOST) public .1.3.6.1.2.1.1.5.0 STRING: 128")
}
record(stringin, "$(P)Contact") {
    field(DESC, "Native agent SET readback")
    field(DTYP, "$(DTYP)")
    field(INP, "@$(HOST) public .1.3.6.1.2.1.1.4.0 STRING: 128")
}
record(stringout, "$(P)ContactSet") {
    field(DESC, "Native agent string SET")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.2.1.1.4.0 STRING: 128 s")
}
