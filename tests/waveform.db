record(waveform, "$(P)WaveSTRING16") {
    field(DESC, "Legacy waveform representation")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 STRING: 128")
    field(FTVL, "STRING")
    field(NELM, "16")
    field(SCAN, ".1 second")
}
