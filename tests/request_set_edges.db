record(longout, "$(P)IntegerSet") {
    field(DESC, "Defined initial value for scanned SET")
    field(VAL, "0")
    field(UDF, "0")
}
record(fanout, "$(P)ScanTrigger") {
    field(DESC, "Direct processing without CA put state")
    field(LNK1, "$(P)IntegerSet")
}
record(longout, "$(P)Command") {
    field(DESC, "CA monitor source for output chain")
    field(VAL, "1")
    field(UDF, "0")
}
record(longout, "$(P)Source") {
    field(DESC, "CP or CPP driven database output")
    field(DOL, "$(P)Command $(LINK,CP)")
    field(OMSL, "closed_loop")
    field(OUT, "$(P)IntegerSet PP")
    field(DISA, "1")
}
record(stringout, "$(P)TextSet") {
    field(DESC, "String output with bounded payload")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.7.0 STRING: 8 s")
}
record(sub, "$(P)AuditIntegerRead") {
    field(DESC, "Request input audit beside queued SET")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)IntegerRead NPP")
    field(INPB, "$(P)IntegerRead.PACT NPP")
    field(INPC, "$(P)IntegerRead.SEVR NPP")
    field(INPD, "$(P)IntegerRead.STAT NPP")
    field(INPE, "$(P)IntegerRead.UDF NPP")
}
