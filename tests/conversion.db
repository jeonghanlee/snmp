record(ai, "$(P)Val") {
    field(DESC, "Conversion and mixed-mode input")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128")
    field(LINR, "SLOPE")
    field(ESLO, "0.1")
    field(FLNK, "$(P)AuditVal")
}
record(sub, "$(P)AuditVal") {
    field(DESC, "Converted value and alarm at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Val NPP")
    field(INPB, "$(P)Val.PACT NPP")
    field(INPC, "$(P)Val.SEVR NPP")
    field(INPD, "$(P)Val.STAT NPP")
    field(INPE, "$(P)Val.UDF NPP")
    field(INPF, "$(P)Val.RVAL NPP")
}
record(ai, "$(P)Raw") {
    field(DESC, "Conversion and mixed-mode input")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.4.0 INTEGER: 128 sR")
    field(LINR, "SLOPE")
    field(ROFF, "0")
    field(ASLO, "1")
    field(AOFF, "0")
    field(SMOO, "0")
    field(ESLO, "0.1")
    field(EOFF, "0")
    field(PREC, "1")
    field(FLNK, "$(P)AuditRaw")
}
record(sub, "$(P)AuditRaw") {
    field(DESC, "Converted value and alarm at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Raw NPP")
    field(INPB, "$(P)Raw.PACT NPP")
    field(INPC, "$(P)Raw.SEVR NPP")
    field(INPD, "$(P)Raw.STAT NPP")
    field(INPE, "$(P)Raw.UDF NPP")
    field(INPF, "$(P)Raw.RVAL NPP")
}
record(longin, "$(P)Integer") {
    field(DESC, "Conversion and mixed-mode input")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.2.0 INTEGER: 128")
    field(FLNK, "$(P)AuditInteger")
}
record(sub, "$(P)AuditInteger") {
    field(DESC, "Converted value and alarm at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Integer NPP")
    field(INPB, "$(P)Integer.PACT NPP")
    field(INPC, "$(P)Integer.SEVR NPP")
    field(INPD, "$(P)Integer.STAT NPP")
    field(INPE, "$(P)Integer.UDF NPP")
}
record(stringin, "$(P)Text") {
    field(DESC, "Conversion and mixed-mode input")
    field(DTYP, "SnmpRequest")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 STRING: 128")
    field(FLNK, "$(P)AuditText")
}
record(sub, "$(P)AuditText") {
    field(DESC, "Converted value and alarm at FLNK")
    field(SNAM, "requestAudit")
    field(INPA, "$(P)Text.UDF NPP")
    field(INPB, "$(P)Text.PACT NPP")
    field(INPC, "$(P)Text.SEVR NPP")
    field(INPD, "$(P)Text.STAT NPP")
    field(INPE, "$(P)Text.UDF NPP")
}
record(longin, "$(P)Legacy") {
    field(DESC, "Legacy poll shares request OID")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128")
    field(SCAN, ".1 second")
}
record(stringin, "$(P)LegacyText") {
    field(DESC, "Legacy text-mask conversion contract")
    field(DTYP, "Snmp")
    field(INP, "@$(HOST) public .1.3.6.1.4.1.55555.3.0 STRING: 128")
    field(SCAN, ".1 second")
}
record(longout, "$(P)Readback") {
    field(DESC, "Legacy output readback shares OID")
    field(DTYP, "Snmp")
    field(OUT, "@$(HOST) public .1.3.6.1.4.1.55555.1.0 INTEGER: 128 i")
}
record(fanout, "$(P)All") {
    field(DESC, "Request all conversion inputs")
    field(LNK0, "$(P)Val")
    field(LNK1, "$(P)Raw")
    field(LNK2, "$(P)Integer")
    field(LNK3, "$(P)Text")
}
